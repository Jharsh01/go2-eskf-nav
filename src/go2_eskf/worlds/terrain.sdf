<?xml version="1.0" ?>
<!--
  terrain.sdf — GENERATED by src/go2_eskf/scripts/make_terrain_world.py.
  Do not hand-edit; re-run the generator instead (it prints the command it used).

  Uneven "mountainous" twin of flat.sdf, for exercising the go2_eskf slip model.
  Identical GPS datum, physics engine, plugins and sun; the flat ground plane is
  replaced by a fractal heightmap, and low-friction patches are laid on the 10 m
  square that square_test.py drives.

  Reverting to flat ground needs NO file edits and NO regeneration — flat.sdf is
  untouched and is still the DEFAULT world:

      ./run_go2_teleop.sh --square              # flat.sdf   (default, as before)
      ./run_go2_teleop.sh --terrain --square    # this world
      ./run_go2_teleop.sh --obstacles           # vendored default.sdf

  The heightmap <uri> MUST be an absolute file:// path (measured: gz resolves
  neither a world-relative path nor GZ_SIM_RESOURCE_PATH for heightmaps), so this
  file is machine-specific. Re-run the generator after moving the workspace.

  GENERATED WITH: python3 src/go2_eskf/scripts/make_terrain_world.py --extent 40 --samples 257 --relief 0.7 --seed 3 --pad-radius 1.5 --pad-blend 2.5 --patch-mu 0.08 --patch-size 3
    terrain      40 x 40 m, 257x257 samples (15.6 cm/cell), relief 0.70 m
    slope        median 3.6 deg, 95th pct 7.5 deg, max 19.5 deg
    square path  elevation 0.00..0.56 m, slope median 3.7 deg / max 16.6 deg
    start pad    flat (elevation 0.000 m) out to r=1.5 m, blended to r=4.0 m
    slip patches 4 of 3.0 x 3.0 m at mu=0.08
-->
<sdf version="1.8">
  <world name="default">
    <!-- Geographic origin for GPS simulation — keep in sync with flat.sdf and
         default.sdf; the ESKF's lat/lon->ENU conversion anchors on this datum. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>30.0444</latitude_deg>
      <longitude_deg>31.2357</longitude_deg>
      <elevation>74.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <physics name="1ms" type="bullet-featherstone">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Plugins -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <!-- Lights -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Terrain. Replaces flat.sdf's infinite ground plane; there is no plane
         underneath, so the 40 x 40 m heightmap is the only floor.
         The 10 m square lives well inside it. -->
    <model name="terrain">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <heightmap>
              <uri>file:///home/harsh/Desktop/robotics_ws/src/go2_eskf/worlds/terrain_height.png</uri>
              <size>40.0 40.0 0.7</size>
              <pos>0 0 0</pos>
            </heightmap>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <heightmap>
              <uri>file:///home/harsh/Desktop/robotics_ws/src/go2_eskf/worlds/terrain_height.png</uri>
              <size>40.0 40.0 0.7</size>
              <pos>0 0 0</pos>
              <texture>
                <diffuse>file:///home/harsh/Desktop/robotics_ws/src/go2_eskf/worlds/terrain_diffuse.png</diffuse>
                <normal>file:///home/harsh/Desktop/robotics_ws/src/go2_eskf/worlds/terrain_normal.png</normal>
                <size>4</size>
              </texture>
            </heightmap>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Low-friction patch: mu=0.08 over 3.0 x 3.0 m at (+5.00, +0.00).
         Sits 1.5 cm proud of the terrain and is tilted to the
         local gradient, so it is the surface the feet actually contact. -->
    <model name="slip_patch_0">
      <static>true</static>
      <pose>5.0000 0.0000 0.2258 -0.03509 0.04389 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>3.0 3.0 0.1</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.08</mu><mu2>0.08</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>3.0 3.0 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.62 0.76 0.85 1</ambient>
            <diffuse>0.70 0.85 0.95 1</diffuse>
            <specular>0.9 0.9 0.9 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Low-friction patch: mu=0.08 over 3.0 x 3.0 m at (+10.00, -5.00).
         Sits 1.5 cm proud of the terrain and is tilted to the
         local gradient, so it is the surface the feet actually contact. -->
    <model name="slip_patch_1">
      <static>true</static>
      <pose>10.0000 -5.0000 0.2725 0.04389 -0.01757 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>3.0 3.0 0.1</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.08</mu><mu2>0.08</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>3.0 3.0 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.62 0.76 0.85 1</ambient>
            <diffuse>0.70 0.85 0.95 1</diffuse>
            <specular>0.9 0.9 0.9 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Low-friction patch: mu=0.08 over 3.0 x 3.0 m at (+5.00, -10.00).
         Sits 1.5 cm proud of the terrain and is tilted to the
         local gradient, so it is the surface the feet actually contact. -->
    <model name="slip_patch_2">
      <static>true</static>
      <pose>5.0000 -10.0000 0.5085 -0.09615 -0.06141 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>3.0 3.0 0.1</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.08</mu><mu2>0.08</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>3.0 3.0 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.62 0.76 0.85 1</ambient>
            <diffuse>0.70 0.85 0.95 1</diffuse>
            <specular>0.9 0.9 0.9 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Low-friction patch: mu=0.08 over 3.0 x 3.0 m at (+0.00, -5.00).
         Sits 1.5 cm proud of the terrain and is tilted to the
         local gradient, so it is the surface the feet actually contact. -->
    <model name="slip_patch_3">
      <static>true</static>
      <pose>0.0000 -5.0000 0.4811 -0.00874 -0.09633 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>3.0 3.0 0.1</size></box>
          </geometry>
          <surface>
            <friction>
              <ode><mu>0.08</mu><mu2>0.08</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>3.0 3.0 0.1</size></box>
          </geometry>
          <material>
            <ambient>0.62 0.76 0.85 1</ambient>
            <diffuse>0.70 0.85 0.95 1</diffuse>
            <specular>0.9 0.9 0.9 1</specular>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
