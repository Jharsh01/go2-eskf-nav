Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Class: rviz_default_plugins/Map
      Name: Map
      Topic:
        Value: /map
        Durability Policy: Transient Local
      Use Timestamp: false
      Color Scheme: map
      Enabled: true
    - Alpha: 1
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 25; 255; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.05
      Name: Planned Path
      Pose Style: Axes
      Topic:
        Value: /planned_path
    - Alpha: 1
      Class: rviz_default_plugins/PoseWithCovariance
      Color: 0; 100; 255
      Enabled: true
      Name: EKF Pose
      Topic:
        Value: /ekf/pose
    - Alpha: 1
      Class: rviz_default_plugins/LaserScan
      Color: 255; 255; 255
      Enabled: true
      Name: LaserScan
      Size (m): 0.05
      Topic:
        Value: /scan
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 25
      Pitch: 1.0
      Yaw: 0.0
      Target Frame: odom
