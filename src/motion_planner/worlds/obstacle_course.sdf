<?xml version="1.0"?>
<!--
  obstacle_course.sdf
  20m x 20m floor with five rectangular obstacles. Layout matches the
  hard-coded grid in NavigationNode::buildDemoMap so the planner sees
  what's actually in the world.
-->
<sdf version="1.10">
  <world name="obstacle_course">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"        name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"  name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"        name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system"            name="gz::sim::systems::Imu"/>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <direction>-0.5 0.5 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>

    <!-- 20x20 floor -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <geometry><box><size>20 20 0.01</size></box></geometry>
        </collision>
        <visual name="v">
          <geometry><box><size>20 20 0.01</size></box></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Border walls (4 thin boxes around the perimeter) -->
    <model name="wall_n"><static>true</static><pose>0 9.9 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>20 0.2 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>20 0.2 1</size></box></geometry>
      <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual></link></model>
    <model name="wall_s"><static>true</static><pose>0 -9.9 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>20 0.2 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>20 0.2 1</size></box></geometry>
      <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual></link></model>
    <model name="wall_e"><static>true</static><pose>9.9 0 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.2 20 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 20 1</size></box></geometry>
      <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual></link></model>
    <model name="wall_w"><static>true</static><pose>-9.9 0 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>0.2 20 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.2 20 1</size></box></geometry>
      <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material></visual></link></model>

    <!-- Obstacles (centers and sizes match buildDemoMap rectangles) -->
    <model name="obs_sw"><static>true</static><pose>-5 -4 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>2 4 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>2 4 1</size></box></geometry>
      <material><ambient>0.7 0.2 0.2 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material></visual></link></model>

    <model name="obs_ne"><static>true</static><pose>3.5 3 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>3 2 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>3 2 1</size></box></geometry>
      <material><ambient>0.2 0.2 0.7 1</ambient><diffuse>0.3 0.3 0.8 1</diffuse></material></visual></link></model>

    <model name="obs_n"><static>true</static><pose>-1 4.5 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>2 3 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>2 3 1</size></box></geometry>
      <material><ambient>0.2 0.7 0.2 1</ambient><diffuse>0.3 0.8 0.3 1</diffuse></material></visual></link></model>

    <model name="obs_se"><static>true</static><pose>4.5 -4 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>3 2 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>3 2 1</size></box></geometry>
      <material><ambient>0.7 0.7 0.2 1</ambient><diffuse>0.8 0.8 0.3 1</diffuse></material></visual></link></model>

    <model name="pillar"><static>true</static><pose>0 0 0.5 0 0 0</pose>
      <link name="l"><collision name="c"><geometry><box><size>2 2 1</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>2 2 1</size></box></geometry>
      <material><ambient>0.5 0.2 0.7 1</ambient><diffuse>0.6 0.3 0.8 1</diffuse></material></visual></link></model>

    <!-- Spawn the diff-drive robot -->
    <include>
      <uri>model://diff_drive_bot</uri>
      <pose>7 -7 0.1 0 0 0</pose>
    </include>

  </world>
</sdf>
